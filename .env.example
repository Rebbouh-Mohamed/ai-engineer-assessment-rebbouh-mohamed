# Gemini API credentials (get free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Superhero API token (get free key by signing in with GitHub: https://superheroapi.com/)
SUPER_HERO_API_KEY=your_superhero_api_token_here
# Alternative alias supported:
# SUPERHERO_API_TOKEN=your_superhero_api_token_here

# Model Selection (defaults to gemini-2.5-flash with fallback to gemini-3.5-flash-lite)
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Dataset path (defaults to data/movies.csv or movies.csv)
MOVIES_CSV_PATH=data/movies.csv

# Logging Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
